#!/usr/bin/env bash
# pre-push 钩子: 类型检查 (frontend tsc -b 与 deploy 一致 / backend mypy strict)
# + lint (ruff/eslint, 与 CI 同口径 — 2026-08-15 前门禁漏 lint 致本地绿 CI 红)
# + 变更行覆盖 ≥90% (diff-cover)
#
# 安装 (团队一次性): git config core.hooksPath scripts/hooks
# 紧急绕过: git push --no-verify
# 自定义对比基准: DIFF_COVERAGE_BASE=origin/main git push
set -euo pipefail

# D2(2026-08-21 事故: 链节点直推 main 绕过 issue→PR 流程): 工厂链环境禁推 main
if [ "${FACTORY_CHAIN:-0}" = 1 ]; then
  while read -r _lref _lsha _rref _rsha; do
    if [ "${_rref}" = "refs/heads/main" ]; then
      echo "pre-push: 工厂链禁止推送 main（issue→PR 铁律），已拒绝" >&2
      exit 1
    fi
  done
fi

REPO=$(git rev-parse --show-toplevel)
COMPARE="${DIFF_COVERAGE_BASE:-origin/main}"
FAIL_UNDER=95

cd "$REPO"

# 仅当本地领先 compare 的 commit 含 .py/.ts 变更时才跑对应 coverage (省时)
PY=$(git diff --name-only "$COMPARE"...HEAD 2>/dev/null | grep '\.py$' || true)
TS=$(git diff --name-only "$COMPARE"...HEAD 2>/dev/null | grep -E '\.(ts|tsx)$' || true)

if [ -z "$PY" ] && [ -z "$TS" ]; then
  echo "[diff-cover] 无 .py/.ts 变更, 跳过"
  exit 0
fi

echo "[diff-cover] 变更行覆盖率检查 (≥${FAIL_UNDER}%, 对比 ${COMPARE})"

if [ -n "$PY" ]; then
  echo "▶ backend: mypy (strict, 与项目规则一致)"
  (cd backend && uv run --all-extras mypy src)
  echo "▶ backend: ruff (与 CI 同口径, 秒级)"
  (cd backend && uv run ruff check src tests scripts)
  echo "▶ backend: pytest --cov + diff-cover"
  (cd backend && uv run --all-extras pytest --cov=src --cov-report=xml:coverage.xml -q)
  (cd backend && uv run --all-extras diff-cover coverage.xml --compare-branch="$COMPARE" --fail-under="$FAIL_UNDER")
fi

if [ -n "$TS" ]; then
  echo "▶ frontend: tsc -b (类型, 与 deploy-frontend build 一致)"
  (cd frontend && npx tsc -b)
  echo "▶ frontend: eslint (与 CI 同口径)"
  (cd frontend && npm run lint)
  echo "▶ frontend: vitest --coverage + diff-cover"
  (cd frontend && npx vitest run --coverage)
  # lcov SF 是 frontend-relative (src/...), git diff 是 repo-relative (frontend/src/...), 加前缀匹配
  sed -i.bak 's|^SF:src/|SF:frontend/src/|' "$REPO/frontend/coverage/lcov.info" 2>/dev/null || true
  rm -f "$REPO/frontend/coverage/lcov.info.bak"
  (cd backend && uv run --all-extras diff-cover "$REPO/frontend/coverage/lcov.info" --compare-branch="$COMPARE" --fail-under="$FAIL_UNDER")
fi

echo "✓ diff-cover 通过 (变更行覆盖 ≥${FAIL_UNDER}%)"
